# Everything below has a working default. Copy to .env.local only to override.

# Where the dashboard reaches the Python coordinator. `npm run dev` sets this.
GRADMESH_COORDINATOR_URL=http://127.0.0.1:8000

# Ports. Change these if 3000 or 8000 are taken on your machine.
PORT=3000
GRADMESH_COORDINATOR_PORT=8000

# Signing key for dashboard sessions. Generated and stored in .gradmesh/ if unset.
# GRADMESH_SESSION_SECRET=
